node_modules/
dist/
# agent-runner ships as a JS GitHub Action — its bundled dist/ MUST be committed
# (GitHub runs action.yml `main: dist/index.js` as-is, with no build step).
!agent-runner/dist/
!agent-runner/dist/**
build/
.next/
out/
coverage/
*.tsbuildinfo
.env
.env.local
.DS_Store
.idea/
.turbo/
.pnpm-store/
*.log
.devdigest/cache/
clones/
playwright-report/
test-results/

# emdash worktree config (local)
.emdash.json

# local scratch from the pr-self-review helper (a captured diff + file list)
.claude/pr-self-review/

# pnpm 10 writes a stub pnpm-workspace.yaml (allowBuilds placeholders) into any
# package dir it installs in. These four packages are deliberately NOT a
# workspace — see the root AGENTS.md — so that file is install noise, never config.
pnpm-workspace.yaml

# deep-research working files (the durable artifact is .claude/skills/frontend-architecture)
research_notes/
reports/
